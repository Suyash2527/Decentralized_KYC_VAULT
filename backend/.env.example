PORT=3001

# --- Database -------------------------------------------------------------
# In Cloud Run this points at the Cloud SQL Auth Proxy sidecar on localhost,
# and carries no password: the proxy injects an IAM access token.
#   postgresql://<sa-name>@<project>.iam@127.0.0.1:5432/kycvault?sslmode=disable
DATABASE_URL=postgresql://postgres:password@localhost:5432/postgres?schema=public

# --- Cloud KMS ------------------------------------------------------------
# These replace ENCRYPTION_KEY and DEPLOYER_PRIVATE_KEY. Values come from
# `terraform output` in infra/terraform.
GCP_PROJECT_ID=
KMS_LOCATION=asia-south1
KMS_KEY_RING=kycvault-prod-keyring
KMS_PII_KEK=pii-kek
KMS_SIGNING_KEY=operator-signing
KMS_SIGNING_KEY_VERSION=1

# --- Blockchain -----------------------------------------------------------
RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
CONTRACT_ADDRESS=0xYOUR_CONTRACT_ADDRESS

# --- Application secrets (Secret Manager in production) --------------------
JWT_SECRET=replace-with-a-long-random-string
GCP_API_KEY=
CORS_ORIGIN=http://localhost:3000
VERIFIER_REGISTRATION_CODE=
PARTNER_REGISTRATION_CODE=

# --- Legacy, migration window only ----------------------------------------
# Needed ONLY until scripts/backfill-envelope.ts reports zero legacy rows.
# Delete both once the backfill is clean. The server refuses to start in
# production without KMS_PII_KEK, so these cannot quietly become the norm.
# ENCRYPTION_KEY=
# ENCRYPTION_KEY_PREVIOUS=
# DEPLOYER_PRIVATE_KEY=
