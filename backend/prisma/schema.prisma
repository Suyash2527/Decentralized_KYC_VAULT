generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Customer {
  id           String @id @default(uuid())
  publicId     String @unique // The ID shared with banks
  encryptedPII String // Envelope-encrypted payload: v2:<wrapped DEK>:<iv>:<tag>:<ciphertext>
  piiHash      String // SHA-256 for integrity and linking to blockchain

  // Cloud KMS key version that wrapped this record's data key. Not needed to
  // decrypt (the wrapped DEK carries its own version) but it makes "which rows
  // are still on the old key version" a query instead of a full scan, which is
  // what rotation reporting and a key-compromise blast-radius answer need.
  kmsKeyVersion String?
  expiresAt DateTime? // Support for self-destructing identities
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  consents  Consent[]

  @@index([kmsKeyVersion])
}

model Consent {
  id           String   @id @default(uuid())
  customerId   String
  partnerId    String
  status       String   @default("GRANTED") // GRANTED, REVOKED
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  customer     Customer @relation(fields: [customerId], references: [publicId])
  
  @@unique([customerId, partnerId])
}

model BankUser {
  id           String   @id @default(uuid())
  username     String   @unique
  passwordHash String
  bankId       String   // e.g. "BANK_A", "BANK_B"
  role         String   // "VERIFIER", "PARTNER"
}

// Records every attempt to read a customer's PII, granted or denied.
//
// Deliberately NOT related to Customer: DPDP erasure removes the plaintext,
// but RBI record-keeping expects the access history to survive. This table
// holds only the pseudonymous publicId and never the data that was disclosed,
// so it stays useful after erasure without becoming a second PII store.
model AccessLog {
  id             String   @id @default(uuid())
  customerId     String // Customer.publicId — pseudonym, kept after erasure
  partnerId      String
  channel        String // "CONSENT" | "OTP"
  outcome        String // "GRANTED" | "DENIED"
  disclosureType String // "FULL" | "NAME_ONLY" | "PROOF_OF_EXISTENCE" | "NONE"
  reason         String? // why access was denied
  createdAt      DateTime @default(now())

  @@index([customerId, createdAt])
  @@index([partnerId, createdAt])
}

// OTP challenges live in the database, not process memory, so they survive
// Cloud Run cold starts and work across horizontally scaled instances.
model OtpChallenge {
  id                String   @id @default(uuid())
  customerId        String
  partnerId         String
  otpHash           String
  salt              String
  disclosureType    String   @default("FULL")
  attemptsRemaining Int      @default(5)
  expiresAt         DateTime
  createdAt         DateTime @default(now())

  @@unique([customerId, partnerId])
  @@index([expiresAt])
}
