VITE_API_URL=http://localhost:3001/api

# Block explorer used for transaction and contract links.
VITE_EXPLORER_URL=https://sepolia.etherscan.io

# Shown in the header so users always know which chain they are on.
VITE_NETWORK_NAME=Sepolia Testnet

# Optional — renders a link to the deployed KYCVault contract in the header.
VITE_CONTRACT_ADDRESS=0x7870Ff19FD81Ac191C677b917ce4eD4cC2ff68A7

# Ethereum JSON-RPC endpoint the browser reads from directly on /chain.
# Any public Sepolia node works; a dedicated node gives a fuller event history.
VITE_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Block the contract was deployed in. Without it, the event scan can only walk
# back a bounded window from the chain head.
VITE_CONTRACT_DEPLOY_BLOCK=
